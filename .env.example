# Taxi AI Translation Bridge - Environment Configuration
# Copy this file to .env and fill in your values

# === OpenAI / LLM Configuration ===
OPENAI_API_KEY=sk-your-openai-api-key-here
# Model to use for translations: gpt-4o-mini (fast/cheap) or gpt-4o (higher quality)
TRANSLATION_MODEL=gpt-4o-mini

# === Evolution API (WhatsApp Bridge) ===
# URL of your local Evolution API instance (via Docker Compose)
EVOLUTION_API_URL=http://localhost:8080
# API Key configured in your Evolution API instance
EVOLUTION_API_KEY=your-evolution-api-key-here

# === Server Configuration ===
PORT=3000

# === Optional: Instance name for Evolution API ===
# EVOLUTION_INSTANCE_NAME=uncle-taxi
