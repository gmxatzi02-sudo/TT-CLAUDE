# ===================================================================
# Evolution API v2 Environment File
# Copy this file to "evolution.env" (gitignored) and fill real values.
# ===================================================================

# === Server ===
SERVER_PORT=8080
EVOLUTION_API_HOST=0.0.0.0
LOG_LEVEL=info

# === Authentication (CRITICAL) ===
# This becomes your EVOLUTION_API_KEY for the Taxi Bridge
GLOBAL_API_KEY=change_this_to_a_very_long_random_string_at_least_32_chars

# === Database (PostgreSQL) ===
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:change_this_strong_password_123!@postgres:5432/evolution?schema=public

# === Redis Cache (strongly recommended) ===
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/0
CACHE_REDIS_PREFIX_KEY=evolution:

# === WhatsApp / Instance Settings ===
# QR code expiration, etc.
QR_CODE_LIMIT=30

# === Webhooks (important for the Taxi Bridge) ===
# The bridge will register its own webhook at runtime via the /webhook route.
# You can also set a default global webhook here if desired.
WEBHOOK_GLOBAL_URL=http://host.docker.internal:3000/webhook/evolution-webhook
# Note: If you changed the host port to 7070, the internal container still listens on 8080.
# The bridge on your Mac should use EVOLUTION_API_URL=http://localhost:7070
WEBHOOK_GLOBAL_ENABLED=true

# === Optional but recommended for production-like runs ===
# DATABASE_SAVE_DATA_INSTANCE=true
# DATABASE_SAVE_DATA_NEW_MESSAGE=true
# etc.

# === License (required for v2.4.0+ in some cases) ===
# LICENSE_KEY=your_license_if_needed

# === Docker internal networking notes ===
# "host.docker.internal" works on Docker Desktop (Mac/Windows) to reach your host machine.
# On Linux you may need to add extra_hosts or use the bridge IP.
